{
  "name": "brandons-agent",
  "displayName": "Brandon's Agent",
  "version": "1.0.0",
  "description": "Brandon's primary automation agent for NF6 Family Office operations. Manages property data, booking workflows, financial calculations, and operational tasks.",
  "owner": "Brandon",
  "status": "active",
  "capabilities": [
    "property-management",
    "booking-automation",
    "financial-calculations",
    "data-retrieval",
    "report-generation",
    "telegram-bot"
  ],
  "telegram": {
    "botName": "Open Claw",
    "entrypoint": "src/telegram.js",
    "commands": [
      "/start - Welcome message",
      "/help - Show all commands",
      "/bookings - View current bookings",
      "/revenue - YTD financial summary",
      "/calculate <nights> <rate> - Calculate net income",
      "/properties - Property details",
      "/status - Agent status"
    ]
  },
  "knowledge": {
    "directory": "./knowledge",
    "description": "LLM knowledge base - domain-specific context, instructions, and reference data that the agent uses for informed decision-making."
  },
  "settings": {
    "model": "claude-opus-4-6",
    "maxTokens": 4096,
    "temperature": 0.7
  },
  "createdAt": "2026-02-20",
  "updatedAt": "2026-02-22"
}
