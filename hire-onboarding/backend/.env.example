# =============================================================================
# Hire Onboarding Automation - Environment Configuration
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Beta Mode ---
# When true, only processes emails from allowed sender domains
BETA_MODE=true
BETA_ALLOWED_DOMAINS=balcpa.com

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://hire_user:hire_pass@localhost:5432/hire_onboarding
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# --- Redis (for BullMQ job queue) ---
REDIS_URL=redis://localhost:6379

# --- Session ---
SESSION_SECRET=change-this-to-a-random-secret-in-production

# --- Dashboard Auth (single-user, Phase 1) ---
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD_HASH=  # bcrypt hash of your password; run: node -e "require('bcryptjs').hash('yourpassword',12).then(console.log)"

# --- Microsoft Graph API (Azure AD App Registration) ---
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# --- Automation Inbox ---
# The mailbox to poll for forwarded hiring emails
AUTOMATION_INBOX_EMAIL=hire-automation@balcpa.com
# Polling interval in seconds
EMAIL_POLL_INTERVAL_SECONDS=60

# --- SharePoint ---
SHAREPOINT_SITE_ID=your-sharepoint-site-id
SHAREPOINT_DRIVE_ID=your-sharepoint-drive-id
# Base folder path in the drive for employee contracts
SHAREPOINT_CONTRACTS_FOLDER=Contracts/Employees

# --- LLM Extraction (Anthropic Claude) ---
ANTHROPIC_API_KEY=your-anthropic-api-key
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096
# Minimum confidence threshold (0.0-1.0) for auto-accepting extracted fields
LLM_CONFIDENCE_THRESHOLD=0.8

# --- Document Generation ---
# Path to contract DOCX templates
TEMPLATES_DIR=./templates
# LibreOffice binary path for DOCX->PDF conversion
LIBREOFFICE_PATH=/usr/bin/libreoffice
# Output directory for generated contracts
OUTPUT_DIR=./output

# --- Reminders ---
# Days after which to send a reminder for unsigned contracts
REMINDER_DAYS_THRESHOLD=7
# How often to check for reminders (cron expression)
REMINDER_CRON=0 9 * * 1-5
